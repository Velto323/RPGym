<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/shop_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- BACK BUTTON -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Wstecz"
        android:src="@drawable/ic_arrow_back"
        app:tint="@android:color/white"
        android:fitsSystemWindows="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sklep"
            android:textSize="26sp"
            android:textColor="@android:color/white"/>

        <!-- GOLD -->
        <TextView
            android:id="@+id/tvShopGold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Złoto: 0"
            android:textSize="18sp"
            android:textColor="@android:color/white"/>

        <!-- PLAYER INFO -->
        <TextView
            android:id="@+id/tvShopInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="HP / Siła"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:orientation="horizontal"/>


            <ImageView
                android:id="@+id/ivHealthPotionIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Mikstura zdrowia"
                android:src="@drawable/health_potion"/>

            <TextView
                android:id="@+id/tvHealthPotions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mikstury zdrowia: 0"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        <!-- POTION COUNTERS -->
        <TextView
            android:id="@+id/tvHealthPotions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HP potions: 0"
            android:textSize="16sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvStrengthPotions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STR potions: 0"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <!-- HP HEAL -->
        <Button
            android:id="@+id/btnBuyHealthPotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mikstury HP (20 złota)"/>
      
           <TextView
                android:id="@+id/tvStrengthPotions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mikstury siły: 0"
                android:textColor="@android:color/white"
                android:textSize="16sp" />


        <!-- STRENGTH BOOST -->
        <Button
            android:id="@+id/btnBuyStrengthPotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mikstury siły (20 złota)"/>

    </LinearLayout>

</FrameLayout>