<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/shop_background"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>

    <!-- BACK BUTTON -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Wstecz"
        android:src="@drawable/ic_arrow_back"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sklep"
            android:textSize="26sp"/>

        <!-- GOLD -->
        <TextView
            android:id="@+id/tvShopGold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Złoto: 0"
            android:textSize="18sp"/>

        <!-- PLAYER INFO -->
        <TextView
            android:id="@+id/tvShopInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="HP / Siła"
            android:textSize="16sp"/>

        <!-- POTION COUNTERS -->
        <TextView
            android:id="@+id/tvHealthPotions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HP potions: 0"
            android:textSize="16sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvStrengthPotions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STR potions: 0"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <!-- HP HEAL -->
        <Button
            android:id="@+id/btnBuyHealthPotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mikstury HP (20 złota)"/>

        <!-- STRENGTH BOOST -->
        <Button
            android:id="@+id/btnBuyStrengthPotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mikstury siły (20 złota)"/>

    </LinearLayout>

</FrameLayout>